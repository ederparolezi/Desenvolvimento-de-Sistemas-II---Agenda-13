
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="Agenda13Sobre.Sobre"
    Title="Sobre"
    BackgroundColor="#F5F5F5"
    NavigationPage.HasNavigationBar="False">

    <VerticalStackLayout
        Padding="25"
        Spacing="20"
        VerticalOptions="Center">

        <!-- Título -->
        <Label
            Text="Sobre o Aplicativo"
            FontSize="32"
            FontAttributes="Bold"
            TextColor="#512BD4"
            HorizontalTextAlignment="Center" />

        <!-- Informações da atividade -->
        <Border
            BackgroundColor="White"
            Stroke="#DDDDDD"
            Padding="25">

            <VerticalStackLayout Spacing="15">

                <Label
                    Text="Cálculo da Diária"
                    FontSize="24"
                    FontAttributes="Bold"
                    TextColor="#512BD4"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Atividade da Agenda 13 - ETEC"
                    TextColor="#222222"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Desenvolvedor: Eder Parolezi"
                    TextColor="#222222"
                    HorizontalTextAlignment="Center" />

                <Label
                    Text="Ano de desenvolvimento: 2026"
                    TextColor="#222222"
                    HorizontalTextAlignment="Center" />

            </VerticalStackLayout>

        </Border>

        <!-- Botão para voltar -->
        <Button
            Text="Voltar"
            Clicked="Voltar_Clicked"
            BackgroundColor="#7959C8"
            TextColor="White" />

    </VerticalStackLayout>

</ContentPage>
