
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
   
x:Class="Agenda13Sobre.MainPage"

    Title="ContratacaoHospedagem"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="{StaticResource Gray100}">

    <!-- Permite rolar a tela no Android -->
    <ScrollView>

        <VerticalStackLayout
            Padding="10"
            Spacing="10">

            <!-- Título do aplicativo -->
            <Label
                Text="Cálculo da Diária"
                FontFamily="Kalam"
                FontSize="50"
                TextColor="{StaticResource Primary}" />

            <!-- Quadro principal -->
            <Frame Padding="10">

                <VerticalStackLayout>

                    <!-- Quantidade de hóspedes -->
                    <Grid
                        RowDefinitions="Auto,Auto"
                        ColumnDefinitions="*,*,2*">

                        <!-- Adultos -->
                        <Label
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Adultos:"
                            TextColor="#222222" />

                        <Label
                            Grid.Row="0"
                            Grid.Column="1"
                            Text="{Binding Value}"
                            BindingContext="{x:Reference stp_adultos}"
                            TextColor="{StaticResource Primary}" />

                        <Stepper
                            Grid.Row="0"
                            Grid.Column="2"
                            x:Name="stp_adultos"
                            Minimum="0"
                            Maximum="10"
                            Increment="1" />

                        <!-- Crianças -->
                        <Label
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="Crianças:"
                            TextColor="#222222" />

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            Text="{Binding Value}"
                            BindingContext="{x:Reference stp_criancas}"
                            TextColor="{StaticResource Primary}" />

                        <Stepper
                            Grid.Row="1"
                            Grid.Column="2"
                            x:Name="stp_criancas"
                            Minimum="0"
                            Maximum="10"
                            Increment="1" />

                    </Grid>

                    <!-- Escolha da suíte -->
                    <Frame
                        Padding="10"
                        Margin="10">

                        <VerticalStackLayout>

                            <Label
                                Text="Escolha sua Suíte"
                                TextTransform="Uppercase"
                                FontSize="Subtitle"
                                TextColor="{StaticResource Primary}" />

                            <Picker
                                x:Name="pck_quarto"
                                Title="Selecione sua Acomodação"
                                ItemDisplayBinding="{Binding Descricao}"
                                TextColor="#222222" />

                        </VerticalStackLayout>

                    </Frame>

                    <!-- Período da estadia -->
                    <Frame
                        Padding="10"
                        Margin="10"
                        BackgroundColor="White">

                        <VerticalStackLayout Spacing="12">

                            <!-- Título da seção -->
                            <Label
                                Text="Período da Estadia"
                                TextTransform="Uppercase"
                                FontSize="Subtitle"
                                TextColor="{StaticResource Primary}" />

                            <!-- Check-in -->
                            <Grid
                                ColumnDefinitions="110,*"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="Check-in:"
                                    TextColor="#222222"
                                    VerticalOptions="Center" />

                                <Frame
                                    Grid.Column="1"
                                    Padding="8,2"
                                    CornerRadius="8"
                                    BorderColor="#DDDDDD"
                                    BackgroundColor="#F5F5F5"
                                    HasShadow="False">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <DatePicker
                                            x:Name="dtpck_checkin"
                                            Grid.Column="0"
                                            DateSelected="dtpck_checkin_DateSelected"
                                            Format="dd/MM/yyyy"
                                            TextColor="#222222"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Fill" />

                                        <Label
                                            Grid.Column="1"
                                            Text="&#x1F4C5;"
                                            FontSize="22"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            Margin="8,0,4,0" />

                                    </Grid>
                                </Frame>
                            </Grid>

                            <!-- Check-out -->
                            <Grid
                                ColumnDefinitions="110,*"
                                ColumnSpacing="8">

                                <Label
                                    Grid.Column="0"
                                    Text="Check-out:"
                                    TextColor="#222222"
                                    VerticalOptions="Center" />

                                <Frame
                                    Grid.Column="1"
                                    Padding="8,2"
                                    CornerRadius="8"
                                    BorderColor="#DDDDDD"
                                    BackgroundColor="#F5F5F5"
                                    HasShadow="False">

                                    <Grid ColumnDefinitions="*,Auto">

                                        <DatePicker
                                            x:Name="dtpck_checkout"
                                            Grid.Column="0"
                                            Format="dd/MM/yyyy"
                                            TextColor="#222222"
                                            BackgroundColor="Transparent"
                                            HorizontalOptions="Fill" />

                                        <Label
                                            Grid.Column="1"
                                            Text="&#x1F4C5;"
                                            FontSize="22"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center"
                                            Margin="8,0,4,0" />

                                    </Grid>
                                </Frame>
                            </Grid>

                        </VerticalStackLayout>
                    </Frame>

                    <!-- Botão Sobre - Agenda 13 -->
                    <Button
                        Text="Sobre"
                        Clicked="Sobre_Clicked" />

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
