
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>

        <!-- Projeto configurado somente para Android -->
        <TargetFrameworks>net10.0-android</TargetFrameworks>

        <!-- Configurações principais -->
        <OutputType>Exe</OutputType>
        <RootNamespace>Agenda13Sobre</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Geração de código XAML -->
        <MauiXamlInflator>SourceGen</MauiXamlInflator>

        <!-- Nome apresentado no celular -->
        <ApplicationTitle>Agenda13Sobre</ApplicationTitle>

        <!-- Identificador exclusivo do aplicativo Android -->
        <ApplicationId>com.companyname.agenda13sobre</ApplicationId>

        <!-- Versão do aplicativo -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <!-- Versão mínima do Android -->
        <SupportedOSPlatformVersion
            Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>

    </PropertyGroup>

    <!-- Recursos do aplicativo -->
    <ItemGroup>

        <!-- Ícone -->
        <MauiIcon
            Include="Resources\AppIcon\appicon.svg"
            ForegroundFile="Resources\AppIcon\appiconfg.svg"
            Color="#512BD4" />

        <!-- Tela de inicialização -->
        <MauiSplashScreen
            Include="Resources\Splash\splash.svg"
            Color="#512BD4"
            BaseSize="128,128" />

        <!-- Imagens -->
        <MauiImage Include="Resources\Images\*" />

        <MauiImage
            Update="Resources\Images\dotnet_bot.png"
            Resize="True"
            BaseSize="300,185" />

        <!-- Fontes -->
        <MauiFont Include="Resources\Fonts\*" />

        <!-- Arquivos adicionais -->
        <MauiAsset
            Include="Resources\Raw\**"
            LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />

    </ItemGroup>

    <!-- Dependências do .NET MAUI -->
    <ItemGroup>

        <PackageReference
            Include="Microsoft.Maui.Controls"
            Version="$(MauiVersion)" />

        <PackageReference
            Include="Microsoft.Extensions.Logging.Debug"
            Version="10.0.0" />

    </ItemGroup>

</Project>
